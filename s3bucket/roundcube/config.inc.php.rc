<?php
/**
 * Flashlight overrides for Roundcube 1.7.
 * DON'T EDIT THIS FILE: base.sh rewrites it at every boot from the Flashlight release, so upgrades can
 * change it. Your own settings go to /mnt/mailserver/etc/roundcube/custom.inc.php, included at the end.
 * Only settings that differ from Roundcube's config/defaults.inc.php are listed here;
 * everything else keeps the upstream default. Values in curly braces are filled in by base.sh.
 */

$config['db_dsnw'] = 'mysql://roundcube:{RoundcubePassword}@localhost/roundcube';

// IMAP: the default localhost:143 (Dovecot on the same server)

// Sending: port 587 with the user's own webmail login and password (the defaults smtp_user = %u, smtp_pass = %p).
// tls:// makes Roundcube start TLS, which Postfix requires on 587. The certificate isn't checked:
// it is issued for the mail host name, not localhost, and this connection never leaves the server.
$config['smtp_host'] = 'tls://localhost:587';
$config['smtp_conn_options'] = [
    'ssl' => ['verify_peer' => false, 'verify_peer_name' => false],
];

// Same limit as Postfix (message_size_limit), so the user sees it before sending
$config['max_message_size'] = '20M';

// A login without @domain gets the main domain (mail.example.com -> example.com)
$config['username_domain'] = '%t';

// Encrypts the user's password inside the session (AES-256 needs a 32-character key)
$config['des_key'] = '{des_key}';
$config['cipher_method'] = 'AES-256-CBC';

$config['plugins'] = ['acl', 'managesieve', 'userinfo'];

// Filters and vacation replies (Dovecot ManageSieve on localhost:4190)
$config['managesieve_vacation'] = 1;

// Elastic is the default skin; users can switch to Larry in Settings > Preferences > User Interface

// Your own settings (read last, so they win): /mnt/mailserver/etc/roundcube/custom.inc.php
// It is never changed by Flashlight upgrades; set values there as in this file, e.g. $config['product_name'] = 'My Mail';
if (is_file('/mnt/mailserver/etc/roundcube/custom.inc.php')) {
    include '/mnt/mailserver/etc/roundcube/custom.inc.php';
}
