#
# Valkey fill check (spam filter only). Runs from cron daily: while the spam filter's data in Valkey take more
# than PERCENT (default 85) of its memory cap (maxmemory), it writes one WARN line a day to
# /mnt/mailserver/log/instance.log. At the cap Valkey drops the data that expire soonest first: the sending limit
# counters and caches, and only then the oldest Bayes words.
# usage: valkey-check [PERCENT]
#
# imds and instance-log live in /usr/local/sbin, which is not in cron's PATH
export PATH=/usr/local/sbin:$PATH
limit=${1:-85}
mem=$(valkey-cli info memory) || exit 0
used=$(sed -n 's/^used_memory:\([0-9]*\).*/\1/p' <<< "$mem")
max=$(sed -n 's/^maxmemory:\([0-9]*\).*/\1/p' <<< "$mem")
[ -n "$used" ] && [ "${max:-0}" -gt 0 ] || exit 0
percent=$(( used * 100 / max ))
[ $percent -ge $limit ] || exit 0
instance-log WARN "valkey: the spam filter's data take $(( used >> 20 )) of $(( max >> 20 )) MB ($percent%); at the cap the sending limits are dropped first"
