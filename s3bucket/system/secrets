#!/bin/bash
#
# Generated secrets that our config files need, in /mnt/mailserver/root/secrets (root only, key=value).
# They let any release rebuild those files with the same values. The credentials file next to it is for
# people and is never parsed.
#
#   secrets init            every boot: create the file (first install), or build it once from the current
#                           config files of an install made before it existed; stop if anything is missing
#   secrets set KEY VALUE   record a value (base.sh, when it generates the secret)
#   secrets get KEY         print a value; fails if the key is missing
#
# Keys: postfix_db_password, roundcube_db_password, roundcube_des_key, pma_db_password, pma_blowfish_secret,
#       padmin_setup_hash; with the spam filter also rspamd_password (base.sh makes it when it is missing)
#
efs=/mnt/mailserver
file=$efs/root/secrets
keys="postfix_db_password roundcube_db_password roundcube_des_key pma_db_password pma_blowfish_secret padmin_setup_hash"

set_value() {
  local tmp=$file.tmp
  { grep -v "^$1=" $file 2> /dev/null; echo "$1=$2"; } > $tmp && chmod 600 $tmp && mv $tmp $file
}

# value of a PHP setting line: $name = '...';
php_value() { sed -n "s/.*$2 *= *'\([^']*\)';.*/\1/p" "$1" | head -1; }

case "$1" in
  init)
    [ -f $file ] && exit 0
    install -m 600 /dev/null $file
    # first install: base.sh records each secret when it generates it
    [ -f $efs/flag ] || exit 0
    # installed before this file existed: take the values from the current config files
    maps=$efs/etc/postfix/mysql
    postfix_db=$(sed -n 's/^password *= *//p' $maps/virtual_mailbox_maps.cf)
    for f in $maps/*.cf; do
      [ "$(sed -n 's/^password *= *//p' $f)" = "$postfix_db" ] || { echo "secrets: $f has another database password"; rm $file; exit 1; }
    done
    dovecot_db=$(grep -o 'password=[^ ]*' $efs/etc/dovecot/dovecot-mysql.conf | head -1 | cut -d= -f2)
    padmin=$efs/www/admin/padmin/config.local.php
    roundcube=$efs/www/webmail/config/config.inc.php
    pma=$efs/www/admin/phpmyadmin/config.inc.php
    [ "$dovecot_db" = "$postfix_db" ] && [ "$(php_value $padmin "\['database_password'\]")" = "$postfix_db" ] ||
      { echo "secrets: Dovecot or PostfixAdmin have another postfix database password"; rm $file; exit 1; }
    set_value postfix_db_password "$postfix_db"
    set_value roundcube_db_password "$(sed -n "s#.*'mysql://roundcube:\([^@]*\)@localhost/roundcube'.*#\1#p" $roundcube)"
    set_value roundcube_des_key "$(php_value $roundcube "\['des_key'\]")"
    set_value pma_db_password "$(php_value $pma "\['controlpass'\]")"
    set_value pma_blowfish_secret "$(php_value $pma "\['blowfish_secret'\]")"
    set_value padmin_setup_hash "$(php_value $padmin "\['setup_password'\]")"
    for k in $keys; do
      grep -q "^$k=." $file || { echo "secrets: $k not found in the config files"; rm $file; exit 1; }
    done ;;
  set)
    set_value "$2" "$3" ;;
  get)
    grep -q "^$2=" $file || { echo "secrets: $2 is not set" >&2; exit 1; }
    sed -n "s/^$2=//p" $file ;;
  *)
    echo "usage: secrets init | set KEY VALUE | get KEY"; exit 2 ;;
esac
