#
# Flashlight data version on EFS and data upgrades between releases.
#
# /mnt/mailserver/versions (key=value) records what the data on EFS belong to:
#   flashlight=   release the data were last brought to (changed only by migrations below)
#   image=, os=   image and OS of the last installed instance (information only)
#   roundcube=, larry=, postfixadmin=, phpmyadmin=   installed package of each web application
#
#   upgrade-data check      right after EFS is mounted, before anything changes: stop if the data belong to a
#                           newer release (old code must not touch them); create the file if it is missing
#   upgrade-data run        once MariaDB runs: if the data are older, bring them to this release step by step. A
#                           step listed in "migrations" runs its script (upgrade-X-Y.sh from the config bucket;
#                           s3bucket/migrations/ in the repository); the other steps change no data. Before the
#                           first script everything is backed up, and restored if a script fails
#   upgrade-data set KEY VALUE
#   upgrade-data app NAME PACKAGE
#                           on existing data, at every install: if the recorded package of web application NAME
#                           isn't this release's PACKAGE, update it with the application's recipe (below), with a
#                           backup of its folder and database, restored if the recipe fails
#   upgrade-data newer-data succeeds if the data belong to a newer release than this one, and prints both
#                           (services-shutdown: an older instance must not resume service on such data)
#   upgrade-data release    prints this installer's release
#
# Starting work on a new version: set this_release and add it to releases (the code names the version being worked
# on). Only if the data need a one-off change, ship upgrade-<previous>-<new>.sh and add the step "<previous>-<new>"
# to migrations (configs that Flashlight owns are simply replaced, web applications are updated by version). A user
# can skip releases: all steps from the data's release up to this one run in a row.
#
this_release=1.1
releases="1.0 1.1"
# the steps that have a migration script, e.g. "1.1-1.2 1.4-1.5"
migrations=""
#
# Testing: THIS_RELEASE, RELEASES, MIGRATIONS and MIGRATIONS_DIR (local folder instead of the config bucket) replace
# the above
this_release=${THIS_RELEASE:-$this_release}
releases=${RELEASES:-$releases}
migrations=${MIGRATIONS-$migrations}
export PATH=/usr/local/sbin:$PATH
efs=/mnt/mailserver
file=$efs/versions

get() { sed -n "s/^$1=//p" $file; }
set_value() {
  local tmp=$file.tmp
  { grep -v "^$1=" $file 2> /dev/null; echo "$1=$2"; } > $tmp && mv $tmp $file
}
# is version $1 newer than version $2?
newer() { [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -1)" = "$1" ]; }

# Backup of everything a migration may change (mail itself is never changed by migrations)
backup() {
  local dir=$1 db dbs
  mkdir -p $dir && chmod 700 $dir || return 1
  cp -p $file $dir/versions || return 1
  mariadb-dump -u root --system=users --insert-ignore > $dir/users.sql || return 1
  dbs=$(mariadb -N -B -u root -e 'SHOW DATABASES') || return 1
  for db in $(grep -vxE 'information_schema|performance_schema|mysql|sys' <<< "$dbs"); do
    mariadb-dump -u root --single-transaction --routines --events --databases $db > $dir/db-$db.sql || return 1
  done
  # (GNU tar applies --exclude only to the paths after it)
  tar czf $dir/files.tar.gz -C $efs \
    --exclude=www/webmail/temp --exclude=www/webmail/logs --exclude=www/admin/phpmyadmin/tmp \
    --exclude=www/admin/padmin/templates_c \
    etc www root automation || return 1
  tar tzf $dir/files.tar.gz > /dev/null
}

# Back to the state of the backup. The failed state is kept next to the backup for diagnosis.
restore() {
  local dir=$1 sql db
  mkdir -p $dir/failed $dir/restored
  tar xzf $dir/files.tar.gz -C $dir/restored
  for d in etc www root automation; do
    [ -e $efs/$d ] && mv $efs/$d $dir/failed/$d
    mv $dir/restored/$d $efs/$d
  done
  # the folders that were not in the backup (temporary files, logs) go back where they were
  for d in www/webmail/temp www/webmail/logs www/admin/phpmyadmin/tmp www/admin/padmin/templates_c; do
    [ -e $dir/failed/$d ] && [ ! -e $efs/$d ] && mv $dir/failed/$d $efs/$d
  done
  for sql in $dir/db-*.sql; do
    db=${sql##*/db-}; db=${db%.sql}
    mariadb -u root -e "DROP DATABASE IF EXISTS \`$db\`"
    mariadb -u root < $sql
  done
  mariadb -u root < $dir/users.sql
  cp -p $dir/versions $file
}

# Web application recipes: the folder on EFS and the database of each application, and update_NAME, which installs
# the new package $pkg into the empty folder $dest (the old one is in $old), following the application's own
# upgrade notes. An application without a recipe here stops the install when its package changes: write its
# recipe in the release that first bumps it.
app_dir() { case $1 in postfixadmin) echo $efs/www/admin/padmin ;; esac; }
app_db() { case $1 in postfixadmin) echo postfix ;; esac; }
update_postfixadmin() {
  # The release tarball contains vendor/ (no composer). config.local.php is ours (base.sh rewrites it right after
  # this), upgrade.php needs it. upgrade.php brings the database schema to the new version and exits with 0 even when
  # it fails, so a second run must find nothing left to do.
  tar xzf $pkg -C $dest --strip-components=1 --no-same-owner &&
    cp -p $old/config.local.php $dest/ &&
    chown -R apache: $dest/templates_c &&
    php $dest/public/upgrade.php &&
    php $dest/public/upgrade.php | grep -q 'all database updates are applied'
}

case "$1" in
  app)
    name=$2 package=$3
    installed=$(get $name)
    [ "$installed" = "$package" ] && exit 0
    if [ -z "$installed" ]; then
      instance-log FAILED "$name: no installed package recorded in ${file#$efs/}, nothing changed"
      exit 1
    fi
    # never back to an older package (an older template on the stack, for example): its code may not know the schema
    if newer "$installed" "$package"; then
      instance-log WARN "$name: $installed is newer than this release's $package, kept"
      exit 0
    fi
    dir=$(app_dir $name) db=$(app_db $name)
    if [ -z "$dir" ] || ! declare -F update_$name > /dev/null; then
      instance-log FAILED "$name: no update recipe for $installed -> $package, nothing changed"
      exit 1
    fi
    bk=$efs/backup/upgrade-$name-$(date +%Y-%m-%d-%H-%M-%S)
    pkg=/root/$package old=$bk/old dest=$dir
    instance-log UPGRADE "$name $installed -> $package, backup in ${bk#$efs/}"
    # backup: the database dump and the old folder itself (moved, not copied: the new package goes to an empty one)
    if ! { mkdir -p $bk && chmod 700 $bk &&
        { [ -z "$db" ] || mariadb-dump -u root --single-transaction --routines --events --databases $db > $bk/db-$db.sql; } &&
        aws s3 cp s3://$BUCKET_CONFIG/$package $pkg --quiet && mv $dir $old; }; then
      instance-log FAILED "$name: backup or download failed, nothing changed"
      exit 1
    fi
    mkdir $dest && update_$name
    rc=$?
    rm -f $pkg
    if [ $rc -ne 0 ]; then
      # the failed state is kept next to the backup for diagnosis
      [ -e $dest ] && mv $dest $bk/failed
      mv $old $dest
      [ -z "$db" ] || { mariadb -u root -e "DROP DATABASE IF EXISTS \`$db\`" && mariadb -u root < $bk/db-$db.sql; }
      instance-log FAILED "$name: update to $package failed, $installed restored (failed state in ${bk#$efs/}/failed)"
      exit 1
    fi
    set_value $name $package
    # upgrade backups are kept for 90 days, like the install logs
    find $efs/backup -maxdepth 1 -name 'upgrade-*' -mtime +90 -exec rm -rf {} +
    instance-log UPGRADE "$name now at $package" ;;
  check)
    if [ ! -f $file ]; then
      if [ -f $efs/flag ]; then
        # installed by v1.0 before this file existed (the only release without it)
        printf '%s\n' flashlight=1.0 roundcube=roundcubemail-1.7.6-complete.tar.gz \
          larry=roundcube-larry-03ccd35.tar.gz postfixadmin=postfixadmin-v4.0.6-php74.tar.gz \
          phpmyadmin=phpMyAdmin-5.2.3-all-languages.tar.gz > $file
      else
        echo "flashlight=$this_release" > $file
      fi
    fi
    data=$(get flashlight)
    if newer "$data" "$this_release"; then
      instance-log FAILED "the data on EFS belong to Flashlight $data, newer than this installer ($this_release): nothing changed"
      exit 1
    fi ;;
  run)
    data=$(get flashlight)
    [ "$data" = "$this_release" ] && exit 0
    # the steps from the data's release up to this one
    steps="" found=""
    for r in $releases; do
      [ -n "$found" ] && steps="$steps $prev-$r"
      [ "$r" = "$data" ] && found=1
      prev=$r
    done
    if [ -z "$found" ]; then
      instance-log FAILED "the data on EFS belong to Flashlight $data, which this installer can't upgrade from: nothing changed"
      exit 1
    fi
    # no step with a migration script: the data themselves don't change, only their release
    scripts=""
    for step in $steps; do
      [[ " $migrations " == *" $step "* ]] && scripts=1
    done
    if [ -z "$scripts" ]; then
      set_value flashlight $this_release
      instance-log UPGRADE "data $data -> $this_release, no data changes in between"
      exit 0
    fi
    dir=$efs/backup/upgrade-$data-$this_release-$(date +%Y-%m-%d-%H-%M-%S)
    instance-log UPGRADE "data $data -> $this_release, backup in ${dir#$efs/}"
    if ! backup $dir; then
      instance-log FAILED "upgrade backup failed, nothing changed"
      exit 1
    fi
    for step in $steps; do
      if [[ " $migrations " != *" $step "* ]]; then
        set_value flashlight ${step#*-}
        continue
      fi
      script=$dir/upgrade-$step.sh
      if [ -n "$MIGRATIONS_DIR" ]; then cp $MIGRATIONS_DIR/upgrade-$step.sh $script
      else aws s3 cp s3://$BUCKET_CONFIG/upgrade-$step.sh $script --quiet
      fi && bash -e $script
      if [ $? -ne 0 ]; then
        restore $dir
        instance-log FAILED "upgrade step $step failed, the data were restored from the backup (failed state kept in ${dir#$efs/}/failed)"
        exit 1
      fi
      set_value flashlight ${step#*-}
      instance-log UPGRADE "step $step done"
    done
    # upgrade backups are kept for 90 days, like the install logs
    find $efs/backup -maxdepth 1 -name 'upgrade-*' -mtime +90 -exec rm -rf {} +
    instance-log UPGRADE "data now at $this_release" ;;
  set)
    set_value "$2" "$3" ;;
  newer-data)
    data=$(get flashlight)
    echo "Flashlight $data (this instance: $this_release)"
    newer "$data" "$this_release" ;;
  release)
    echo "$this_release" ;;
  *)
    echo "usage: upgrade-data check | run | set KEY VALUE | app NAME PACKAGE | newer-data | release"; exit 2 ;;
esac
