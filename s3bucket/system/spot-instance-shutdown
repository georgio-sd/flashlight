#!/bin/bash
#
# Watches for the 2-minute spot interruption notice and replaces this instance cleanly when it arrives.
# The notice appears in instance metadata as spot/instance-action, e.g. {"action":"terminate","time":"..."}
#
# imds and instance-log live in /usr/local/sbin, which is not in cron's PATH
export PATH=/usr/local/sbin:$PATH
while true; do
  if action=$(imds spot/instance-action); then
    exec /mnt/mailserver/automation/replace-instance "spot-interruption: AWS notice $action"
  fi
  sleep 5
done
