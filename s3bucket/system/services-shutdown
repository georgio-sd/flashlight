#!/bin/bash
#
# Double instance protection.
# Every instance writes /mnt/mailserver/flag-ec2id-<its id> during install and removes the others' flags.
# When another instance's flag appears, a newer instance has taken over the EFS: this one stops
# everything that writes to it or could start yet another instance (cron jobs, the log rotation and
# certificate renewal timers, the spot watcher), database first, and waits.
# Usually this instance is terminated soon after (spot replacement, rebuild, successful stack update).
# But if the newer instance is terminated first (its install failed and the stack update rolled back),
# this instance takes over again: EFS flag, services, cron, and the Elastic IP last (an SSH session to the
# temporary public IP drops at that moment). It waits for "terminated": while the other instance is still
# shutting down, its MariaDB may still have the database open.
# It doesn't take over while the data belong to a newer release: the other instance upgraded them before it
# failed (a stack update straight to a newer release, without maintenance mode), and this release can't run
# them. It then waits until the data are back at its release (the upgrade backup restored by hand), or until a
# new install of the newer release replaces it.
#
# imds and instance-log live in /usr/local/sbin
export PATH=/usr/local/sbin:$PATH
# an empty ID would make our own flag look foreign, so wait until the metadata answers
until id=$(imds instance-id) && [ -n "$id" ]; do sleep 5; done
region=$(imds placement/region)
me=flag-ec2id-$id

# the instance that owns the EFS now (the newest foreign flag), or nothing
owner() {
  find /mnt/mailserver -maxdepth 1 -type f -name 'flag-ec2id-*' ! -name "$me" -printf '%T@ %f\n' |
    sort -n | tail -1 | sed 's/^[^ ]* flag-ec2id-//'
}

# "gone" only when EC2 says terminated or doesn't know the instance any more (NotFound, or an empty answer for an
# instance terminated long ago); API errors mean "wait"
gone() {
  local out
  out=$(aws ec2 describe-instances --instance-ids "$1" --region "$region" \
    --query 'Reservations[0].Instances[0].State.Name' --output text 2>&1)
  [ "$out" = terminated ] || [ "$out" = None ] || [[ "$out" == *InvalidInstanceID.NotFound* ]]
}

while true; do
  taker=$(owner)
  if [ -n "$taker" ]; then
    systemctl stop mariadb
    systemctl stop postfix dovecot httpd php-fpm opendkim crond autoshutdown
    # timers that would change files on the EFS: log rotation and certificate renewal
    systemctl stop logrotate.timer certbot-renew.timer
    instance-log STOP "instance $taker took over the EFS: services, cron and spot watcher stopped"
    # wait until the owner is gone (a newer owner, another flag, is followed instead) and the data are at a
    # release this instance can run
    warned=""
    while sleep 60; do
      taker=$(owner)
      [ -n "$taker" ] && ! gone "$taker" && continue
      if data=$(upgrade-data newer-data); then
        [ -n "$warned" ] || instance-log STOP "instance ${taker:-?} upgraded the data to $data and is gone: services stay stopped. Update stage 2 to the new release again, or restore the upgrade backup (docs/UPGRADING.md)"
        warned=1
        continue
      fi
      break
    done
    rm -f /mnt/mailserver/flag-ec2id-*
    printf "Do not delete this file" > /mnt/mailserver/$me
    systemctl start mariadb
    systemctl start postfix dovecot httpd php-fpm opendkim crond
    systemctl is-enabled -q autoshutdown && systemctl start autoshutdown
    systemctl start logrotate.timer certbot-renew.timer
    aws ec2 associate-address --instance-id "$id" --allocation-id "$(cat /usr/local/etc/eip-allocation-id)" \
      --allow-reassociation --region "$region" > /dev/null
    instance-log RESUME "instance ${taker:-?} is gone (terminated): EFS, services and the Elastic IP are back on this instance"
  fi
  sleep 15
done
