#!/bin/bash
#
# Decides what happens after an install. Self-contained: it may run when base.sh failed before
# installing its helpers or mounting EFS.
#
#   install-finish result BASE_RC [USER_RC]   from UserData, after base.sh and user-script.sh; UserData then
#                                             reboots, but only after a good install
#   install-finish ready                      from cron after the reboot (scheduled only after a good install)
#
# Good install: the EFS flag is written; after the reboot the main services must be running, then READY goes
#   to instance.log and SUCCESS to CloudFormation.
# Failed install: FAILED goes to instance.log, and the install log is also kept in the config bucket
#   (install-logs/), which survives even a rolled-back stack. Then:
#   - stack being created or updated: FAILURE goes to CloudFormation at once (rollback in a minute instead of
#     a 30-minute timeout); no retries, the person updating the stack takes over
#   - instance replaced by the ASG (spot, price check, scheduled rebuild, health check): up to 3 installs in
#     a row are tried on new instances, 5 minutes apart; after that the instance stays up for diagnosis
#   A failed install isn't rebooted: the services configured before the failure would start half-configured.
# Alert emails (stack parameter AlertEmail, SNS topic ALERT_TOPIC), only for replacements by the ASG, not for
#   stack operations (the person updating the stack watches them): the first failed install ("retrying"), the
#   last one ("giving up"), and READY after failures ("recovered"). READY also checks that every AlertEmail
#   address is subscribed and confirmed (WARN lines otherwise).
# A failed user-script.sh is only reported (USER line): it's an optional addition and doesn't fail the install.
#
# Needs STACK, AWS_REGION and BUCKET_CONFIG, optional ALERT_TOPIC and MAIL_DOMAIN (exported by UserData; saved
# for the after-reboot run).
# Testing: DRY_RUN=1 only prints the AWS actions; STACK_STATUS=... pretends a stack status; RETRY_PAUSE=seconds;
# SERVICES=... replaces the list of services checked after the reboot
#
efs=/mnt/mailserver
log=/var/log/flashlight-install.log
env_file=/usr/local/etc/install-finish.env
max_attempts=3
# the services that must be up after the install: base.sh lists them (they depend on the stack's parameters)
services=${SERVICES:-"mariadb postfix dovecot httpd php-fpm opendkim"}
if [ -z "$SERVICES" ] && [ -f /usr/local/etc/flashlight-services ]; then
  . /usr/local/etc/flashlight-services
  services=$services_running
fi
[ -f $env_file ] && . $env_file

imds() {
  local token
  token=$(curl -s -X PUT http://169.254.169.254/latest/api/token -H "X-aws-ec2-metadata-token-ttl-seconds: 60")
  curl -s -f -H "X-aws-ec2-metadata-token: $token" http://169.254.169.254/latest/meta-data/$1
}
id=$(imds instance-id)
pool="$(imds instance-type)/$(imds placement/availability-zone)"

# the same line format as /usr/local/sbin/instance-log, written directly (that helper may not exist yet)
event() {
  local line
  line=$(printf '%s %s %-22s %-8s %s' "$(date '+%F %T')" "$id" "$pool" "$1" "$2")
  echo "$line"
  mountpoint -q $efs && { mkdir -p $efs/log; echo "$line" >> $efs/log/instance.log; }
}

aws_do() {
  if [ "$DRY_RUN" = 1 ]; then echo "DRY RUN: aws $*"; else aws "$@"; fi
}

# alert "subject" "text": an email to the AlertEmail addresses (nothing without the alert topic)
alert() {
  [ -n "$ALERT_TOPIC" ] || return 0
  local subject="Flashlight ${MAIL_DOMAIN:-$STACK}: $1"
  aws_do sns publish --topic-arn "$ALERT_TOPIC" --region "$AWS_REGION" --subject "${subject:0:99}" \
    --message "$(printf '%s\n\nStack: %s (%s)\nInstance: %s %s\nEvent log: %s/log/instance.log\n' \
      "$2" "$STACK" "$AWS_REGION" "$id" "$pool" $efs)" > /dev/null || event WARN "alert email not sent: $1"
}

# the newest log of a failed replacement install in the last 24 hours (empty if none)
last_failed_replace() {
  local key
  key=$(aws s3api list-objects-v2 --bucket "$BUCKET_CONFIG" --prefix install-logs/replace- \
    --query "sort_by(Contents[?LastModified>='$(date -u -d '-24 hours' +%Y-%m-%dT%H:%M:%S)'], &LastModified)[-1].Key" \
    --output text 2> /dev/null)
  [ "$key" = None ] || echo "$key"
}

# READY: is every AlertEmail address subscribed and confirmed? (the addresses come from the stack's parameters)
check_subscriptions() {
  local wanted subs addr state
  [ -n "$ALERT_TOPIC" ] || return 0
  wanted=$(aws cloudformation describe-stacks --stack-name "$STACK" --region "$AWS_REGION" \
    --query "Stacks[0].Parameters[?ParameterKey=='AlertEmail'].ParameterValue" --output text 2> /dev/null)
  if ! subs=$(aws sns list-subscriptions-by-topic --topic-arn "$ALERT_TOPIC" --region "$AWS_REGION" \
       --query 'Subscriptions[].[Endpoint,SubscriptionArn]' --output text 2> /dev/null) || [ -z "$wanted" ]; then
    event WARN "alert emails: the subscriptions of the AlertEmail addresses can't be checked"
    return
  fi
  for addr in ${wanted//,/ }; do
    # a confirmed subscription has an ARN; an address may have several (one added by hand): the confirmed one wins
    state=$(awk -v a="${addr,,}" 'tolower($1) == a { print $2 }' <<< "$subs" | sort | head -1)
    case "$state" in
      arn:*) ;;
      PendingConfirmation)
        event WARN "alert email $addr: not confirmed yet; click the link in the email from AWS Notifications (valid for 48 hours after the stack was created or updated)" ;;
      *)
        event WARN "alert email $addr: no subscription (unsubscribed, or not confirmed within 48 hours). To subscribe it again, update the stack without it, then with it" ;;
    esac
  done
}

signal() {
  aws_do cloudformation signal-resource --stack-name "$STACK" --logical-resource-id AutoScalingGroup \
    --unique-id "$id" --status "$1" --region "$AWS_REGION" 2> /dev/null
}

failed() {
  local reason=$1 status kind where attempts
  status=${STACK_STATUS:-$(aws cloudformation describe-stacks --stack-name "$STACK" --region "$AWS_REGION" \
    --query 'Stacks[0].StackStatus' --output text 2> /dev/null)}
  # the log name says who started this instance: a stack operation, or an ASG replacement (only these are retried)
  case "$status" in *_IN_PROGRESS) kind=stack ;; *_COMPLETE) kind=replace ;; *) kind=unknown ;; esac
  where="s3://$BUCKET_CONFIG/install-logs/$kind-$(date +%Y-%m-%d-%H-%M-%S)-$id.log"
  aws s3 cp $log "$where" --quiet || where="(upload failed) $log on the instance"
  event FAILED "$reason; install log: $where"
  case "$status" in
    *_IN_PROGRESS)
      signal FAILURE
      if [[ "$status" == UPDATE* ]]; then
        event FAILED "stack update failed, no retry. If the previous instance had stopped its services for this one, it takes the EFS, its services and the Elastic IP back by itself once the rollback terminates this instance (RESUME line)"
      else
        event FAILED "stack $status failed, no retry"
      fi ;;
    *_COMPLETE)
      # replacement installs that failed in a row: their logs of the last 3 hours in the config bucket
      # (works without EFS too)
      attempts=$(aws s3api list-objects-v2 --bucket "$BUCKET_CONFIG" --prefix install-logs/replace- \
        --query "length(Contents[?LastModified>='$(date -u -d '-3 hours' +%Y-%m-%dT%H:%M:%S)'])" --output text 2> /dev/null)
      [[ "$attempts" =~ ^[0-9]+$ ]] || attempts=$max_attempts
      if [ "$attempts" -lt $max_attempts ]; then
        event REPLACE "install failed ($attempts of $max_attempts attempts), trying a new instance in $(( ${RETRY_PAUSE:-300} / 60 )) minutes"
        # an email for the first failure only; the next one comes when an install works or the last one fails
        [ "$attempts" = 1 ] && alert "server install failed on a new instance, retrying" \
          "The mail server didn't install on a new instance that replaced the previous one (Spot interruption, scheduled rebuild or a failed health check). The server is down until an install works.

Reason: $reason
Next: a new instance tries again in $(( ${RETRY_PAUSE:-300} / 60 )) minutes (attempt $attempts of $max_attempts). Another email follows when an install works, or when the last attempt fails.
Install log: $where"
        sleep ${RETRY_PAUSE:-300}
        aws_do autoscaling terminate-instance-in-auto-scaling-group --instance-id "$id" \
          --no-should-decrement-desired-capacity --region "$AWS_REGION" > /dev/null
      else
        event FAILED "giving up after $attempts failed installs in 3 hours; this instance stays up for diagnosis"
        alert "server is DOWN, install failed $attempts times" \
          "The mail server didn't install on $attempts new instances in a row, and no further attempt is made. The server is down: mail is not received (other servers keep it in their queues for a few days) and not sent.

Reason of the last failure: $reason
Install log: $where (the logs of the earlier attempts are in the same folder)
The last instance stays up for diagnosis. Once the cause is fixed, start a new install: terminate this instance (the Auto Scaling group starts a new one) or update the stack."
      fi ;;
    *)
      event FAILED "stack status unknown ('$status'), no retry"
      alert "server install failed, no retry" \
        "The mail server didn't install on a new instance, and the stack's status can't be read ('$status'), so no further attempt is made. The server may be down.

Reason: $reason
Install log: $where" ;;
  esac
}

case "$1" in
  result)
    base_rc=$2 user_rc=$3
    # this instance's install log stays on EFS (root only: a first install's trace contains passwords)
    if mountpoint -q $efs; then
      install -d -m 700 $efs/log/install
      install -m 600 $log $efs/log/install/$(date +%Y-%m-%d-%H-%M-%S)-$id.log
      find $efs/log/install -name '*.log' -mtime +90 -delete
    fi
    [ -n "$user_rc" ] && [ "$user_rc" != 0 ] && event USER "user-script.sh failed with code $user_rc (details in the install log)"
    if [ "$base_rc" = 0 ]; then
      # the flag tells the next instances that the first install is done
      printf "Flashlight Mail Server v%s (re)deployed at %s\nDo not delete this file" \
        "$(/usr/local/sbin/upgrade-data release)" "$(date)" > $efs/flag
      # after the reboot: check the services, then READY (cron-boot-runner runs /etc/cron.once once)
      printf 'STACK=%q\nAWS_REGION=%q\nBUCKET_CONFIG=%q\nALERT_TOPIC=%q\nMAIL_DOMAIN=%q\n' \
        "$STACK" "$AWS_REGION" "$BUCKET_CONFIG" "$ALERT_TOPIC" "$MAIL_DOMAIN" > $env_file
      mkdir -p /etc/cron.once
      # (its lines also go to the install log)
      printf '#!/bin/bash\n/usr/local/sbin/install-finish ready >> %s 2>&1\n' $log > /etc/cron.once/install-ready
      chmod 700 /etc/cron.once/install-ready
    else
      # only the command's name: its arguments may hold generated passwords
      cmd=$(grep '^+ ' $log | tail -1 | awk '{print $2}')
      # a step that handles passwords runs untraced: its name instead (base.sh, secret_step)
      [ "$cmd" = secret_step ] && cmd="secret step: $(grep '^+ secret_step ' $log | tail -1 | cut -d' ' -f3-)"
      # 124: UserData's timeout stopped a hung install
      if [ "$base_rc" = 124 ]; then failed "base.sh still running after 60 minutes, stopped at command '$cmd'"
      else failed "base.sh exit $base_rc at command '$cmd'"
      fi
    fi ;;
  ready)
    # services may still be starting: wait up to 2 minutes
    for i in $(seq 24); do
      down=$(for s in $services; do systemctl is-active -q $s || echo -n "$s "; done); down=${down% }
      [ -z "$down" ] && break
      sleep 5
    done
    if [ -z "$down" ]; then
      event READY "installed and rebooted, services up"
      # read before the signal: after it, a stack update can complete within seconds and look like a replacement
      status=${STACK_STATUS:-$(aws cloudformation describe-stacks --stack-name "$STACK" --region "$AWS_REGION" \
        --query 'Stacks[0].StackStatus' --output text 2> /dev/null)}
      signal SUCCESS
      check_subscriptions
      # "recovered": a replacement install worked after failed ones that weren't followed by a working install yet.
      # The newest failure log is remembered on EFS, so each run of failures gets one such email; it is
      # remembered after a stack operation too (no email then), so a later replacement doesn't report it again.
      last=$(last_failed_replace)
      if [ -n "$last" ] && [ "$last" != "$(cat $efs/log/alert-last-failure 2> /dev/null)" ]; then
        [[ "$status" == *_COMPLETE ]] && alert "server is up again" \
          "The mail server installed on a new instance after failed attempts and is working again. Mail that other servers kept in their queues arrives over the next hours.

Last failure log: s3://$BUCKET_CONFIG/$last"
        echo "$last" > $efs/log/alert-last-failure
      fi
    else
      failed "services not running after the reboot: $down"
    fi ;;
  *)
    echo "usage: install-finish result BASE_RC [USER_RC] | install-finish ready"; exit 2 ;;
esac
