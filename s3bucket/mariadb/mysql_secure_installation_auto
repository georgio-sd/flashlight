#! /bin/sh
#
# A non-interactive replacement for mysql_secure_installation
# Mail Server Project (c) Sam Stewart
#
# MariaDB 10.4+ (tested on 10.11, AlmaLinux 10): a fresh install has no anonymous users and
# no test database, so the only step left is giving root a password.
# root keeps unix_socket login: root on the server (shell, db-backup) needs no password,
# phpMyAdmin logs in as root with the password.
#

set -o errexit # abort on nonzero exitstatus
set -o nounset # abort on unbound variable

db_root_password="$(pwgen 16 1)"

printf "MariaDB\n   Link: https://$ADMIN_DOMAIN/myadmin\n" >> /root/credentials
printf "   login: root\n   password: $db_root_password\n\n" >> /root/credentials
chmod 700 /mnt/mailserver/automation/db-backup
printf '55  22  *  *  * root /mnt/mailserver/automation/db-backup\n' >> /mnt/mailserver/etc/crontab

mysql --user=root -e "ALTER USER root@localhost IDENTIFIED VIA unix_socket OR mysql_native_password USING PASSWORD('${db_root_password}');"
