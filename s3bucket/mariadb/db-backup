#!/usr/bin/bash
#
# Make database backups (runs as root, which logs in to MariaDB through the unix socket without a password)
#
# Dumps contain password hashes and mailbox data: readable by root only
umask 077
DATE=$(date +%Y-%m-%d)
mysqldump --opt -u root --events mysql | gzip -c > /mnt/mailserver/backup/mysql.${DATE}.sql.gz
mysqldump --opt -u root --default-character-set=utf8mb4 postfix | gzip -c > /mnt/mailserver/backup/postfix.${DATE}.sql.gz
mysqldump --opt -u root --default-character-set=utf8mb4 phpmyadmin | gzip -c > /mnt/mailserver/backup/phpmyadmin.${DATE}.sql.gz
mysqldump --opt -u root --default-character-set=utf8mb4 roundcube | gzip -c > /mnt/mailserver/backup/roundcube.${DATE}.sql.gz
#
# Delete old backups
#
f28days=$(date +%s --date="-28 days")
cd /mnt/mailserver/backup
for file in *.gz; do
    fdate=$(echo $file | sed 's/[^0-9/]//g')
    fsec=$(date +%s --date=${fdate})
    if [[ $fsec -lt $f28days ]]; then
        rm $file
    fi
done
