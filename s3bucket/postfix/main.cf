# Flashlight Postfix configuration (Postfix 3.8, AlmaLinux 10).
# DON'T EDIT THIS FILE: base.sh rewrites it at every boot from the Flashlight release, so upgrades can change it.
# Your own settings go to /mnt/mailserver/etc/postfix/main.local.cf (same format): at every boot each of its
# settings is applied over this file with "postconf -e", so they win; upgrades never touch it.
# Only settings that differ from Postfix's built-in defaults are listed; see postconf(5) for the rest
# and "postconf -n" for the effective values. The mail host and main domain names are filled in by base.sh.

compatibility_level = 3.8

# Paths of the AlmaLinux package (sendmail, newaliases and mailq come through alternatives)
sendmail_path = /usr/sbin/sendmail.postfix
newaliases_path = /usr/bin/newaliases.postfix
mailq_path = /usr/bin/mailq.postfix
manpage_directory = /usr/share/man
readme_directory = /usr/share/doc/postfix/README_FILES
sample_directory = /usr/share/doc/postfix/samples

# Local lookup tables: this Postfix has no hash:/btree: (RHEL 10 dropped Berkeley DB), lmdb replaces them
default_database_type = lmdb
alias_maps = lmdb:/etc/aliases
alias_database = lmdb:/etc/aliases

#
# Identity and network
#
myhostname = {MailDomain}
mydomain = {MainDomain}
myorigin = $myhostname
mydestination = localhost.$mydomain, localhost
inet_interfaces = all
inet_protocols = ipv4
# only the server itself may relay without logging in (the default would add the whole VPC subnet)
mynetworks = 127.0.0.0/8

#
# Mail domains, mailboxes and aliases from the PostfixAdmin database
#
# (proxy: one shared database connection through proxymap instead of one per Postfix process)
virtual_mailbox_domains = proxy:mysql:/etc/postfix/mysql/virtual_mailbox_domains.cf
virtual_mailbox_maps = proxy:mysql:/etc/postfix/mysql/virtual_mailbox_maps.cf,
 proxy:mysql:/etc/postfix/mysql/virtual_alias_domain_mailbox_maps.cf
virtual_alias_maps = proxy:mysql:/etc/postfix/mysql/virtual_alias_maps.cf,
 proxy:mysql:/etc/postfix/mysql/virtual_alias_domain_maps.cf,
 proxy:mysql:/etc/postfix/mysql/virtual_alias_domain_catchall_maps.cf
relay_domains = proxy:mysql:/etc/postfix/mysql/relay_domains.cf
# delivery to the mailboxes through Dovecot LMTP (Dovecot's recommended way; socket defined in dovecot.conf)
virtual_transport = lmtp:unix:private/dovecot-lmtp

#
# Queue and message size
#
# (mail that can't be delivered is retried for 5 days before it is returned to the sender, Postfix's default)
message_size_limit = 20971520

#
# Per-client limits (anvil): connections and messages per minute, except the server itself
#
anvil_rate_time_unit = 60s
smtpd_client_connection_count_limit = 20
smtpd_client_connection_rate_limit = 30
smtpd_client_message_rate_limit = 30
smtpd_client_event_limit_exceptions = 127.0.0.0/8
smtpd_error_sleep_time = 20
smtpd_hard_error_limit = 15
# recipients per message for logged-in users (ports 587 and 465, master.cf); the spam filter also limits how many
# messages each user sends (Rspamd ratelimit). Change it in main.local.cf.
flashlight_submission_recipient_limit = 20

#
# SMTP protocol hygiene and restrictions
#
# relaying is for the server itself and logged-in users only; others get a permanent 5xx
# (the built-in default answers with a temporary 4xx, so spammers would keep retrying)
smtpd_relay_restrictions = permit_mynetworks, permit_sasl_authenticated, reject_unauth_destination
smtpd_helo_required = yes
disable_vrfy_command = yes
smtpd_discard_ehlo_keywords = etrn, silent-discard
smtpd_helo_restrictions = permit_mynetworks,
 permit_sasl_authenticated,
 reject_non_fqdn_helo_hostname,
 reject_invalid_helo_hostname
# a logged-in user sends only as their own address or an alias of it: checked on ports 587 and 465, where users
# log in (master.cf: there it comes before everything else, as webmail logs in from the server itself)
smtpd_sender_login_maps = proxy:mysql:/etc/postfix/mysql/sender_login_maps.cf
flashlight_submission_sender_restrictions = reject_authenticated_sender_login_mismatch,
 permit_mynetworks,
 permit_sasl_authenticated,
 reject_non_fqdn_sender,
 reject_unknown_sender_domain
smtpd_sender_restrictions = permit_mynetworks,
 permit_sasl_authenticated,
 reject_non_fqdn_sender,
 reject_unknown_sender_domain
# (last: a full mailbox is refused here instead of being bounced later; Dovecot's quota-status service, dovecot.conf)
smtpd_recipient_restrictions = permit_mynetworks,
 permit_sasl_authenticated,
 reject_non_fqdn_recipient,
 reject_unknown_recipient_domain,
 reject_multi_recipient_bounce,
 reject_unauth_destination,
 check_policy_service unix:private/quota-status
smtpd_data_restrictions = permit_mynetworks,
 permit_sasl_authenticated,
 reject_unauth_pipelining,
 reject_multi_recipient_bounce

#
# Login (SASL) through Dovecot. It is switched on only for ports 587 and 465 in master.cf:
# port 25 (mail from other servers) then keeps working if Dovecot is down, and passwords
# can't be guessed through it.
#
smtpd_sasl_type = dovecot
smtpd_sasl_path = private/dovecot-auth
smtpd_sasl_security_options = noanonymous

#
# TLS for incoming connections. Port 25 stays opportunistic so that old servers can still deliver;
# where TLS is mandatory (ports 587 and 465, our own users) only TLS 1.2 and newer is accepted.
#
smtpd_tls_cert_file = /etc/letsencrypt/live/{MailDomain}/fullchain.pem
smtpd_tls_key_file = /etc/letsencrypt/live/{MailDomain}/privkey.pem
smtpd_tls_security_level = may
smtpd_tls_mandatory_protocols = >=TLSv1.2
smtpd_tls_loglevel = 1
smtpd_tls_received_header = yes

#
# TLS for outgoing connections (opportunistic)
#
smtp_tls_security_level = may
smtp_tls_CAfile = /etc/pki/tls/certs/ca-bundle.crt
smtp_tls_CApath = /etc/pki/tls/certs
smtp_tls_loglevel = 1
smtp_tls_note_starttls_offer = yes
smtp_tls_session_cache_database = lmdb:$data_directory/smtp_tls_session_cache

#
# Milters: the Rspamd spam check (stack parameter Antispam; base.sh fills in the list) and OpenDKIM's signature.
# If one of them is down, mail still flows (unchecked or unsigned). Mail made on the server itself (cron,
# PostfixAdmin) is only signed.
#
smtpd_milters = {SmtpdMilters}
non_smtpd_milters = inet:127.0.0.1:8891
milter_default_action = accept
