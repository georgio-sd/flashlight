# Postfix lookup in the PostfixAdmin database (mailboxes reached through an alias domain).
# Query from PostfixAdmin 4 DOCUMENTS/POSTFIX_CONF.txt. {database_password} is filled in by base.sh.
user = postfix
password = {database_password}
hosts = localhost
dbname = postfix
query = SELECT maildir FROM mailbox,alias_domain WHERE alias_domain.alias_domain = '%d' and mailbox.username = CONCAT('%u', '@', alias_domain.target_domain) AND mailbox.active='1' AND alias_domain.active='1'
