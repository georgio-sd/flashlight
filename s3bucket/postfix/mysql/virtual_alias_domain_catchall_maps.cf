# Postfix lookup in the PostfixAdmin database (catch-all of the target domain for an alias domain).
# Query from PostfixAdmin 4 DOCUMENTS/POSTFIX_CONF.txt. {database_password} is filled in by base.sh.
user = postfix
password = {database_password}
hosts = localhost
dbname = postfix
query = SELECT goto FROM alias,alias_domain WHERE alias_domain.alias_domain = '%d' and alias.address = CONCAT('@', alias_domain.target_domain) AND alias.active='1' AND alias_domain.active='1'
